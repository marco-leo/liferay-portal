<%@ include file="/init.jsp" %>

<%
String allowedTargetClassNameGroupTitle = allowedTargetClassNameGroup[0];

String activeQualifiers = ParamUtil.getString(request, allowedTargetClassNameGroupName + "-option", commerceQualifiersDisplayContext.getActiveQualifiers(allowedTargetClassNameGroup));
%>

<aui:input name='<%= allowedTargetClassNameGroupName + "-option" %>' type="hidden" value="<%= activeQualifiers %>" />

<div class="row">
	<div class="col-12">
		<commerce-ui:panel
			bodyClasses="flex-fill"
			collapsed="<%= false %>"
			collapsible="<%= false %>"
			title='<%= LanguageUtil.get(request, commerceQualifiersDisplayContext.getLabel(allowedTargetClassNameGroupTitle) + "-eligibility") %>'
		>
			<div class="row">
				<aui:fieldset markupView="lexicon">
					<aui:input checked='<%= Objects.equals(activeQualifiers, "all") %>' label='<%= "all-" + commerceQualifiersDisplayContext.getPluralLabel(allowedTargetClassNameGroupTitle) %>' name='<%= "qualifiers--" + allowedTargetClassNameGroupName %>' type="radio" value="all" />

					<%
					for (String allowedTargetClassName : allowedTargetClassNameGroup) {
					%>

						<aui:input checked="<%= Objects.equals(activeQualifiers, allowedTargetClassName) %>" label='<%= "specific-" + commerceQualifiersDisplayContext.getPluralLabel(allowedTargetClassName) %>' name='<%= "qualifiers--" + allowedTargetClassNameGroupName %>' type="radio" value="<%= allowedTargetClassName %>" />

					<%
					}
					%>

				</aui:fieldset>
			</div>
		</commerce-ui:panel>
	</div>
</div>

<%
String allowedTargetClassName = activeQualifiers;
%>

<c:if test='<%= !Objects.equals(activeQualifiers, "all") %>'>
	<%@ include file="/qualifiers/qualifier.jspf" %>
</c:if>