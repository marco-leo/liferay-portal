<%
List<CommerceDefaultSettingRel> commerceDefaultSettingRels = commerceDefaultSettingDisplayContext.getCommerceDefaultSettingRels("target");

for (CommerceDefaultSettingRel commerceDefaultSettingRel : commerceDefaultSettingRels) {
%>

	<div class="mb-3 row">
		<div class="col">
			<aui:select label="type" name='<%= "targetType--" + commerceDefaultSettingRel.getCommerceDefaultSettingRelId() + "--" %>' wrapperCssClass="mb-0">

				<%
				for (CommerceQualifierMetadata commerceQualifierMetadata : commerceDefaultSettingDisplayContext.getCommerceQualifiersMetadata()) {
				%>

					<aui:option label="<%= commerceQualifierMetadata.getLabel() %>" selected="<%= Objects.equals(commerceDefaultSettingRel.getClassName(), commerceQualifierMetadata.getModelClassName()) %>" value="<%= commerceQualifierMetadata.getModelClassName() %>" />

				<%
				}
				%>

			</aui:select>
		</div>

		<div class="col">
			<aui:input autoFocus="<%= true %>" label="id" name='<%= "targetId--" + commerceDefaultSettingRel.getCommerceDefaultSettingRelId() + "--" %>' type="number" value="<%= commerceDefaultSettingRel.getClassPK() %>" wrapperCssClass="mb-0">
				<aui:validator name="number" />
				<aui:validator name="min">0</aui:validator>
			</aui:input>
		</div>

		<div class="col-auto d-flex flex-column justify-content-end">
			<portlet:actionURL name="/default_settings/edit_commerce_default_setting" var="editCommerceDefaultSettingActionURL">
				<portlet:param name="<%= Constants.CMD %>" value="<%= Constants.DELETE %>" />
				<portlet:param name="redirect" value="<%= currentURL %>" />
				<portlet:param name="commerceDefaultSettingRelId" value="<%= String.valueOf(commerceDefaultSettingRel.getCommerceDefaultSettingRelId()) %>" />
			</portlet:actionURL>

			<clay:link
				borderless="<%= true %>"
				cssClass="btn-monospaced"
				displayType="secondary"
				href="<%= editCommerceDefaultSettingActionURL %>"
				icon="trash"
				type="button"
			/>
		</div>
	</div>

<%
}
%>

<div class="mb-3 row">
	<div class="col">
		<aui:select label="type" name="targetType--new--" showEmptyOption="<%= true %>" wrapperCssClass="mb-0">

			<%
			for (CommerceQualifierMetadata commerceQualifierMetadata : commerceDefaultSettingDisplayContext.getCommerceQualifiersMetadata()) {
			%>

				<aui:option label="<%= commerceQualifierMetadata.getLabel() %>" value="<%= commerceQualifierMetadata.getModelClassName() %>" />

			<%
			}
			%>

		</aui:select>
	</div>

	<div class="col">
		<aui:input autoFocus="<%= true %>" label="id" name="targetId--new--" type="number" wrapperCssClass="mb-0">
			<aui:validator name="number" />
			<aui:validator name="min">0</aui:validator>
		</aui:input>
	</div>
</div>