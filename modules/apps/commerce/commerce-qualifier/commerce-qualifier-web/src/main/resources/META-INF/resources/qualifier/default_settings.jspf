<c:if test="<%= commerceDefaultSettingsDisplayContext.hasPermission(ActionKeys.UPDATE) %>">
	<div id="<%= commerceDefaultSettingsDisplayContext.getItemFinderRootName(sourceClassName) %>"></div>

	<liferay-frontend:component
		context='<%=
			HashMapBuilder.<String, Object>put(
				"datasetId", commerceDefaultSettingsDisplayContext.getDatasetId(sourceClassName)
			).put(
				"inputPlaceHolderLabel", LanguageUtil.get(request, commerceDefaultSettingsDisplayContext.getInputPlaceHolderLabel(sourceClassName))
			).put(
				"itemFinderRootName", commerceDefaultSettingsDisplayContext.getItemFinderRootName(sourceClassName)
			).put(
				"itemSelectedPlaceHolderLabel", LanguageUtil.get(request, commerceDefaultSettingsDisplayContext.getItemSelectedPlaceHolderLabel(sourceClassName))
			).put(
				"panelHeaderLabelLabel", LanguageUtil.get(request, commerceDefaultSettingsDisplayContext.getPanelHeaderLabelLabel(sourceClassName))
			).put(
				"rootPortletId", portletDisplay.getRootPortletId()
			).put(
				"sourceName", commerceDefaultSettingsDisplayContext.getRESTModelName2(sourceClassName)
			).put(
				"sourceRESTContextPath", commerceDefaultSettingsDisplayContext.getRESTContextPath(sourceClassName)
			).put(
				"sourceRESTSchema", commerceDefaultSettingsDisplayContext.getRESTSchema(sourceClassName)
			).put(
				"targetId", commerceDefaultSettingsDisplayContext.getClassPK()
			).put(
				"targetName", commerceDefaultSettingsDisplayContext.getRESTModelName1()
			).put(
				"titleLabelLabel", LanguageUtil.get(request, commerceDefaultSettingsDisplayContext.getTitleLabelLabel(sourceClassName))
			).build()
		%>'
		module="js/default_settings"
	/>

	<commerce-ui:panel
		bodyClasses="p-0"
		title="<%= LanguageUtil.get(request, commerceDefaultSettingsDisplayContext.getPluralLabel(sourceClassName)) %>"
	>
		<frontend-data-set:headless-display
			apiURL="<%= commerceDefaultSettingsDisplayContext.getQualifierAPIURL(sourceClassName) %>"
			fdsActionDropdownItems="<%= commerceDefaultSettingsDisplayContext.getFDSActionDropdownItems(sourceClassName) %>"
			formName="fm"
			id="<%= commerceDefaultSettingsDisplayContext.getDatasetId(sourceClassName) %>"
			itemsPerPage="<%= 10 %>"
			namespace="<%= liferayPortletResponse.getNamespace() %>"
			pageNumber="<%= 1 %>"
			portletURL="<%= currentURLObj %>"
		/>
	</commerce-ui:panel>
</c:if>