<c:if test="<%= commerceQualifiersDisplayContext.hasPermission(ActionKeys.UPDATE) %>">
	<div id="<%= commerceQualifiersDisplayContext.getItemFinderRootName(allowedTargetClassName) %>"></div>

	<liferay-frontend:component
		context='<%=
			HashMapBuilder.<String, Object>put(
				"datasetId", commerceQualifiersDisplayContext.getDatasetId(allowedTargetClassName)
			).put(
				"inputPlaceHolderLabel", LanguageUtil.get(request, commerceQualifiersDisplayContext.getInputPlaceHolderLabel(allowedTargetClassName))
			).put(
				"itemFinderRootName", commerceQualifiersDisplayContext.getItemFinderRootName(allowedTargetClassName)
			).put(
				"itemSelectedPlaceHolderLabel", LanguageUtil.get(request, commerceQualifiersDisplayContext.getItemSelectedPlaceHolderLabel(allowedTargetClassName))
			).put(
				"panelHeaderLabelLabel", LanguageUtil.get(request, commerceQualifiersDisplayContext.getPanelHeaderLabelLabel(allowedTargetClassName))
			).put(
				"rootPortletId", portletDisplay.getRootPortletId()
			).put(
				"sourceId", commerceQualifiersDisplayContext.getClassPK()
			).put(
				"sourceName", commerceQualifiersDisplayContext.getRESTModelName1()
			).put(
				"targetName", commerceQualifiersDisplayContext.getRESTModelName2(allowedTargetClassName)
			).put(
				"targetRESTContextPath", commerceQualifiersDisplayContext.getRESTContextPath(allowedTargetClassName)
			).put(
				"targetRESTSchema", commerceQualifiersDisplayContext.getRESTSchema(allowedTargetClassName)
			).put(
				"titleLabelLabel", LanguageUtil.get(request, commerceQualifiersDisplayContext.getTitleLabelLabel(allowedTargetClassName))
			).build()
		%>'
		module="js/qualifier"
	/>

	<commerce-ui:panel
		bodyClasses="p-0"
		title="<%= LanguageUtil.get(request, commerceQualifiersDisplayContext.getPluralLabel(allowedTargetClassName)) %>"
	>
		<frontend-data-set:headless-display
			apiURL="<%= commerceQualifiersDisplayContext.getQualifierAPIURL(allowedTargetClassName) %>"
			fdsActionDropdownItems="<%= commerceQualifiersDisplayContext.getFDSActionDropdownItems(allowedTargetClassName) %>"
			formName="fm"
			id="<%= commerceQualifiersDisplayContext.getDatasetId(allowedTargetClassName) %>"
			itemsPerPage="<%= 10 %>"
			namespace="<%= liferayPortletResponse.getNamespace() %>"
			pageNumber="<%= 1 %>"
			portletURL="<%= currentURLObj %>"
		/>
	</commerce-ui:panel>
</c:if>